---
import clsx from "clsx";
import Link from "@components/base/Link";
import { myName } from "@utils/constants";
---

<div class="hero-overlay">
  <p class="hero-kicker animate-appear">Full-stack developer · Edinburgh</p>
  <h1 class="hero-name exclude-animate-appear">
    {
      myName.split(" ").map((word, index) => (
        <span
          class={clsx(
            "relative inline-block whitespace-nowrap",
            `name-word-${index}`
          )}
        >
          {word.split("").map((char, index) => {
            return (
              <span class={clsx("inline-block", `animate-text-${index}`)}>
                {char}
              </span>
            );
          })}
        </span>
      ))
    }
  </h1>
  <p class="hero-tagline animate-appear">
    I build interactive experiences for the web — fast, accessible, and a
    little bit cosmic.
  </p>
  <p class="hero-hint animate-appear">
    Your cursor has gravity — drag to spin the galaxy
  </p>
  <div class="hero-actions animate-appear">
    <Link to="projects" className="inline-block" client:load>
      <button class="button hero-cta">See my work</button>
    </Link>
    <Link to="contact" className="inline-block" client:load>
      <button class="button hero-cta--secondary">Get in touch</button>
    </Link>
  </div>
</div>

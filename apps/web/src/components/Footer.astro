---
import { externalLinks } from "@utils/constants";
---

<footer class="site-footer page-padding page-max-width">
  <div class="flex gap-6">
    <a
      href={externalLinks.githubProfile}
      target="_blank"
      rel="noopener"
      class="link">Github</a
    >
    <a href={externalLinks.linkedin} target="_blank" rel="noopener" class="link"
      >LinkedIn</a
    >
  </div>
  <p class="site-footer__signal">
    <span data-local-time>--:--</span> in Edinburgh
  </p>
  <p class="link">© Olly Marsters {new Date().getFullYear()}</p>
</footer>

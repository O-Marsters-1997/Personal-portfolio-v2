---
import Icon from "@components/base/Icon";
import ImgOverlay from "@components/ImgOverlay.astro";

type Props = {
  title: string;
  titleShort: string;
  description: string;
  category: string;
  src: string;
  alt: string;
  tech: string[];
  githubHref: string;
  index: number;
};

const { title, titleShort, category, src, alt, tech, githubHref, index } =
  Astro.props;
const link = `/project/${titleShort}`;

const techLabels: Record<string, string> = {
  materialUi: "Material UI",
  mongoDb: "MongoDB",
  nextjs: "Next.js",
  postgresql: "PostgreSQL",
  typescript: "TypeScript",
  javascript: "JavaScript",
};
const formatTech = (name: string) =>
  techLabels[name] ?? name.charAt(0).toUpperCase() + name.slice(1);
---

<div class=`project-item project-item__${index}`>
  <div class="project-media relative cursor-pointer">
    <span class="project-index" aria-hidden="true"
      >{String(index + 1).padStart(2, "0")}</span
    >
    <div class="project-links">
      <a href={githubHref} target="_blank" rel="noopener" aria-label="Github">
        <Icon
          icon="github"
          width="w-4 sm:w-5 cursor-pointer"
          projectName={titleShort}
          client:load
        />
      </a>
      <Icon
        icon="external"
        width="w-4 sm:w-5 cursor-pointer"
        projectName={titleShort}
        client:load
      />
    </div>
    <a href={link} aria-label={`View ${title}`}>
      <ImgOverlay titleShort={titleShort} src={src} alt={alt} />
    </a>
  </div>
  <div class="project-meta animate-project-appear">
    <span class="project-category">{category}</span>
    <h3 class="project-title">{title}</h3>
    <ul class="project-tech" aria-label="Technologies used">
      {tech.map((item) => <li>{formatTech(item)}</li>)}
    </ul>
  </div>
</div>

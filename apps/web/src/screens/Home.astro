---
import HeroScene from "@components/hero/HeroScene";
import CanvasOverlay from "@components/canvas/CanvasOverlay.astro";
---

<div id="home" class="hero">
  <HeroScene client:only="react" />
  <div class="hero-content">
    <CanvasOverlay />
  </div>
  <div class="hero-scroll-cue animate-appear" aria-hidden="true">
    <span class="hero-scroll-cue__line"></span>
  </div>
</div>

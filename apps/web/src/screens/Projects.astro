---
import base from "@/data/projects.json";
import Project from "@components/Project.astro";
import Heading from "@components/Heading.astro";

const { projects } = base;
---

<div
  id="projects"
  class="page-padding page-max-width page-margin-top animate-appear"
>
  <Heading title="Projects" />
  <p class="body1 projects-intro">
    A few things I've designed, built and shipped — select any project for the
    full story.
  </p>
  <div class="projects-grid flex 2xl:justify-between flex-wrap gap-8">
    {
      projects.map((project: any, index) => (
        <Project
          title={project.title}
          titleShort={project.titleShort}
          description={project.description}
          category={project.category}
          src={project.imgSrc}
          alt={project.imgAlt}
          tech={project.technologiesUsed}
          githubHref={project.githubHref}
          index={index}
        />
      ))
    }
  </div>
</div>

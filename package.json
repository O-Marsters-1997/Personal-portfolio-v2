{
  "name": "portfolio-monorepo",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@portfolio/web",
    "dev:cms": "turbo run dev --filter=@portfolio/cms",
    "build": "turbo run build",
    "lint": "turbo run lint --filter='*'",
    "format": "turbo run format"
  },
  "devDependencies": {
    "turbo": "latest"
  }
}
